{
  "rules": [
    {
      "id": "archangelos-browser-multipart-uploads",
      "allowed": {
        "origins": [
          "https://REPLACE_WITH_FIREBASE_HOSTING_DOMAIN",
          "http://localhost:5500",
          "http://127.0.0.1:5500"
        ],
        "methods": ["PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
